# reviewbot: environment for `docker compose up -d` (docs/deploy.md).
# `reviewbot init` writes this file as .env (mode 600). Copying it by hand:
#   cp .env.example .env && chmod 600 .env
# Never commit .env (it is in .gitignore).

# --- GitLab -------------------------------------------------------------------
# Bot account token (scope api, role Reporter in the groups).
GITLAB_TOKEN=
# Optional service token (Maintainer): resolving threads, reviewer assignment,
# labels, webhook sync. Empty = those features are off.
GITLAB_SERVICE_TOKEN=
# Secret of the GitLab webhook (gitlab.events webhook or both); any long
# random string, e.g. `openssl rand -hex 32`.
GITLAB_WEBHOOK_SECRET=

# --- Claude: one of the two ---------------------------------------------------
# Subscription token from `claude setup-token` (sk-ant-oat...).
CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key (sk-ant-api...).
ANTHROPIC_API_KEY=

# --- Pages (optional) ---------------------------------------------------------
# Token of /usage and the other pages; empty = open (a warning at start).
USAGE_TOKEN=

# --- Compose ------------------------------------------------------------------
# Images (published to ghcr.io; `docker compose build` builds them locally).
REVIEWBOT_IMAGE=ghcr.io/fixcik/gitlab-review-bot:latest
REVIEWBOT_SANDBOX_IMAGE=ghcr.io/fixcik/gitlab-review-bot-sandbox:latest
# Service config mounted into the bot and the egress proxy.
REVIEWBOT_CONFIG=./config.yaml
# Data directory: the SAME absolute path on the host and in the container
# (= data_dir in the config), writable for uid 1000.
REVIEWBOT_DATA_DIR=/var/lib/reviewbot
# Linux: group of /var/run/docker.sock (`stat -c %g /var/run/docker.sock`);
# not needed on macOS (Docker Desktop).
DOCKER_GID=999
